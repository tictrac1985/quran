{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ورتل القرآن",
  "version": "1.0.0",
  "identifier": "com.wartil.quran",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ورتل القرآن",
        "width": 1150,
        "height": 860,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["assets/mushaf-qcf4"],
    "windows": {
      "nsis": {
        "languages": ["Arabic"],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
